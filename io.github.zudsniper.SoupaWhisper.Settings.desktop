[Desktop Entry]
Type=Application
Name=SoupaWhisper Settings
GenericName=Dictation Settings
Comment=Choose the microphone, hotkey and speech model for SoupaWhisper
Exec=@PYTHON@ @SETTINGS@
Icon=audio-input-microphone
Terminal=false
Categories=Utility;
Keywords=dictation;voice;whisper;microphone;speech;
StartupNotify=true
StartupWMClass=io.github.zudsniper.SoupaWhisper.Settings
